rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin safely
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/write their own profile
    // Admins can read/write all profiles
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // Collectors collection:
    match /collectors/{collectorId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == collectorId || isAdmin()
      );
    }

    // Waste requests - users can create and read their own, admins can read/write all, assigned collectors can read/write
    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.collectorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if request.auth != null && isAdmin();
    }
  }
}
